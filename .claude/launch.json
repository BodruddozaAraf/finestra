{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finestra-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "finestra-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "finestra-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "studio", "run", "dev"],
      "port": 3333
    }
  ]
}
